---
// 1. IMPORTS
import Layout from '~/layouts/PageLayout.astro';
import Features from '~/components/widgets/Features.astro';
import Contact from '~/components/widgets/Contact.astro';

import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

import heroImage from '~/assets/images/hero-image.png';

const projects = (await getCollection('project')).sort(
  (a, b) => (b.data.publishDate?.valueOf() || 0) - (a.data.publishDate?.valueOf() || 0)
);

const metadata = {
  title: 'Jeremy Ramesh — Cybersecurity & IOT',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>

<!-- HERO SECTION -->
<section id="about" class="relative md:-mt-[76px] not-prose">
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 pt-32 md:pt-40 pb-12 md:pb-20">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-16 items-center">

      <!-- LEFT SIDE -->
      <div class="text-center md:text-left">
        <h1 class="text-5xl md:text-6xl font-bold leading-tighter tracking-tighter mb-4 font-heading dark:text-gray-200">
          Hi, I'm <span class="text-oxblood dark:text-white highlight">Jeremy Ramesh ;)</span>
        </h1>

        <!-- TWEAKED: Replaced dark:text-slate-300 with dark:text-cream/80 for a warmer, clearer contrast -->
        <p class="text-xl text-muted mb-8 dark:text-cream/80">
          <span class="font-semibold text-gray-900 dark:text-white">Cybersecurity & IOT student</span><br />
          Fluent in C, familiar with Docker, ZFS, Crowdsec and Caddy. Find here the tools I've developed.
        </p>

        <!-- Action Buttons -->
        <div class="flex flex-col sm:flex-row gap-4 justify-center md:justify-start">
          <a class="btn w-full sm:w-auto bg-oxblood text-white border-oxblood hover:bg-oxblood/90 hover:border-oxblood/90 transition sm:mb-0" href="#projects">
            View My Work
          </a>

          <!-- TWEAKED: Added !text-umber to override default dark mode gray text -->
          <a
            class="btn w-full sm:w-auto bg-cream !text-umber border-cream hover:bg-white hover:scale-105 transition-all duration-200 font-bold"
            href="https://github.com/jems-cyber"
            target="_blank"
            rel="noopener"
          >
            <!-- TWEAKED: Added text-umber to the SVG to ensure the icon color matches the text -->
            <svg class="w-5 h-5 mr-2 -ml-1.5 inline-block text-umber" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5"></path></svg>
            GitHub
          </a>
        </div>
      </div>

      <!-- RIGHT SIDE: Picture -->
      <div class="relative flex justify-center mt-10 md:mt-0">
        <div class="relative group">
          <div class="absolute -inset-1 bg-gradient-to-r from-oxblood to-umber rounded-2xl blur opacity-25 group-hover:opacity-50 transition duration-1000 group-hover:duration-200"></div>
          <Image
            src={heroImage}
            alt="Jeremy Ramesh"
            class="relative w-full max-w-sm md:max-w-md object-contain bg-white rounded-2xl shadow-2xl border border-white/10"
          />
        </div>
      </div>
    </div>
  </div>
</section>

  <!-- FEATURES WIDGET -->
  <Features
    id="features"
    tagline="Skills"
    title="My Tech Stack"
    subtitle="The languages, tools, and environments I use."
    items={[
      { title: 'Debian/Mint', description: 'OS architecture, user and file rights.', icon: 'tabler:server' },
      { title: 'C & Python', description: 'Developed scripts for my OSINT tool.', icon: 'tabler:code' },
      { title: 'Cybersecurity Tools', description: 'Gobuster, Nmap, OSINT.', icon: 'tabler:shield-lock' },
      { title: 'Security Best Practices', description: 'Building with security and defense in mind.', icon: 'tabler:lock-check' },
    ]}
  />

<!-- PROJECTS SECTION -->
  <section id="projects" class="px-4 py-16 mx-auto max-w-7xl lg:py-20">
    <div class="flex flex-col mb-6 md:mb-12 text-center">
      <h2 class="text-3xl font-bold md:text-4xl md:leading-tight">Recent Projects</h2>
      <!-- TWEAKED: Removed slate-400 -->
      <p class="text-muted dark:text-cream/70 mt-2 text-xl">A glimpse into my work.</p>
    </div>

    <div class="grid gap-6 row-gap-5 md:grid-cols-2 lg:grid-cols-3">
      {projects.map((project) => (
        <article class="mb-6 transition hover:shadow-xl rounded-2xl bg-white dark:bg-[#261814] shadow-md border border-gray-200 dark:border-white/5">
          <a href={`/project/${project.id}`} data-astro-reload class="block overflow-hidden rounded-t-2xl">
            <img src={project.data.image} class="object-cover w-full h-48 transition hover:scale-105 duration-300" alt={project.data.title} />
          </a>
          <div class="p-6">
            <h3 class="mb-2 text-xl font-bold leading-tight sm:text-2xl font-heading">
              <a href={`/project/${project.id}`} data-astro-reload class="hover:text-oxblood dark:hover:text-cream transition duration-200">
                {project.data.title}
              </a>
            </h3>
            <!-- TWEAKED: Removed slate-400 -->
            <p class="text-muted dark:text-cream/80 text-base mb-4">{project.data.description}</p>

            <!-- TWEAKED: Added !text-cream to the skill tags to guarantee high contrast -->
            <div class="flex flex-wrap gap-2 mb-4">
              {project.data.skills.map((skill) => (
                <span class="bg-oxblood !text-cream text-xs font-semibold px-2.5 py-0.5 rounded-full border border-white/10 shadow-sm">
                  {skill}
                </span>
              ))}
            </div>

            <a href={`/project/${project.id}`} data-astro-reload class="inline-flex items-center font-medium dark:text-white hover:underline">
              Learn more about my Cloud
              <svg class="w-4 h-4 ml-1" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M12.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd"></path></svg>
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- CONTACT SECTION -->
  <Contact
    id="contact"
    title="Get in touch"
    button="Send Message"
  />

</Layout>
