---
// 1. IMPORTS
import Layout from '~/layouts/PageLayout.astro';
import Features from '~/components/widgets/Features.astro';
import Contact from '~/components/widgets/Contact.astro';

import { getCollection } from 'astro:content'; 
import { Image } from 'astro:assets'; 

// IMPORT YOUR PICTURE HERE:
// AstroWind aliases '~' to the 'src' folder, so this points to src/assets/images/...
import heroImage from '~/assets/images/hero-image.png';

// Fetching your projects for the cards
const projects = (await getCollection('project')).sort(
  (a, b) => (b.data.publishDate?.valueOf() || 0) - (a.data.publishDate?.valueOf() || 0)
);

// Metadata
const metadata = {
  title: 'Jeremy Ramesh — Cybersecurity & IOT',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>

<!-- HERO SECTION: Custom Side-by-Side Layout -->
<section class="relative md:-mt-[76px] not-prose">
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 pt-32 md:pt-40 pb-12 md:pb-20">

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-16 items-center">

      <!-- LEFT SIDE: Text and Buttons -->
      <div class="text-center md:text-left">
        <h1 class="text-5xl md:text-6xl font-bold leading-tighter tracking-tighter mb-4 font-heading dark:text-gray-200">
          Hi, I'm <span class="text-accent dark:text-white highlight">Jeremy Ramesh ;)</span>
        </h1>

        <p class="text-xl text-muted mb-8 dark:text-slate-300">
          <span class="font-semibold text-gray-900 dark:text-white">Cybersecurity & IOT student</span><br />
          Fluent in C, familiar with Docker, ZFS, Crowdsec and Caddy. Find here the tools I've developed as well as my ongoing and finished projects.
        </p>

        <!-- Action Buttons -->
        <div class="flex flex-col sm:flex-row gap-4 justify-center md:justify-start">
          <a class="btn btn-primary w-full sm:w-auto" href="#projects">
            <svg class="w-5 h-5 mr-2 -ml-1.5 inline-block" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><rect x="3" y="7" width="18" height="13" rx="2"></rect><path d="M8 7v-2a2 2 0 0 1 2 -2h4a2 2 0 0 1 2 2v2"></path><line x1="12" y1="12" x2="12" y2="12.01"></line><path d="M3 13a20 20 0 0 0 18 0"></path></svg>
            View My Work
          </a>
          <a class="btn w-full sm:w-auto" href="https://github.com/jems-cyber" target="_blank" rel="noopener">
            <svg class="w-5 h-5 mr-2 -ml-1.5 inline-block" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5"></path></svg>
            GitHub
          </a>
        </div>
      </div>
	<!-- RIGHT SIDE: Picture -->
	      <div class="relative flex justify-center mt-10 md:mt-0">
		<!-- Clean, simple rounded rectangle -->
		<Image
		  src={heroImage}
		  alt="Jeremy Ramesh"
		  class="w-full max-w-sm md:max-w-md object-contain bg-white rounded-2xl shadow-xl border border-gray-100 dark:border-gray-800"
		/>
	      </div>
  </div>
</section>

  <!-- FEATURES WIDGET: Your Tech Stack -->
  <Features
    id="features"
    tagline="Skills"
    title="My Tech Stack"
    subtitle="The languages, tools, and environments I use."
    items={[
      { title: 'Debian/Mint', description: 'OS architecture, user and file rights, SFTP, Samba configurations.', icon: 'tabler:server' },
      { title: 'C & Python', description: 'Developed scripts for my OSINT tool.', icon: 'tabler:code' },
      { title: 'Cybersecurity Tools', description: 'Gobuster, Nmap, OSINT.', icon: 'tabler:shield-lock' },
      { title: 'Security Best Practices', description: 'Building with security and defense in mind.', icon: 'tabler:lock-check' },
    ]}
  />


<!-- PROJECTS SECTION (Summary Cards) -->
  <section id="projects" class="px-4 py-16 mx-auto max-w-7xl lg:py-20 bg-slate-50 dark:bg-slate-950">
    <div class="flex flex-col mb-6 md:mb-12 text-center">
      <h2 class="text-3xl font-bold md:text-4xl md:leading-tight">Recent Projects</h2>
      <p class="text-muted dark:text-slate-400 mt-2 text-xl">A glimpse into my work.</p>
    </div>

    <div class="grid gap-6 row-gap-5 md:grid-cols-2 lg:grid-cols-3">
      {projects.map((project) => (
        <article class="mb-6 transition hover:shadow-lg rounded-2xl bg-white dark:bg-slate-900 shadow-md border border-gray-200 dark:border-gray-700">
          <a href={`/project/${project.id}`} class="block overflow-hidden rounded-t-2xl">
            <img src={project.data.image} class="object-cover w-full h-48 transition hover:scale-105 duration-300" alt={project.data.title} />
          </a>
          <div class="p-6">
            <h3 class="mb-2 text-xl font-bold leading-tight sm:text-2xl font-heading">
              <a href={`/project/${project.id}`} class="hover:text-primary transition ease-in-duration-200">
                {project.data.title}
              </a>
            </h3>
            <p class="text-muted dark:text-slate-400 text-base mb-4">{project.data.description}</p>

            <!-- Skill Tags -->
            <div class="flex flex-wrap gap-2 mb-4">
              {project.data.skills.map((skill) => (
                <span class="bg-blue-100 text-blue-800 text-xs font-medium px-2.5 py-0.5 rounded dark:bg-blue-900 dark:text-blue-300">
                  {skill}
                </span>
              ))}
            </div>

            <!-- Link to detailed tutorial page -->
            <a href={`/project/${project.id}`} class="inline-flex items-center font-medium text-primary hover:underline">
              More explanation
              <svg class="w-4 h-4 ml-1" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M12.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd"></path></svg>
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- CONTACT SECTION -->
  <Contact
    id="contact"
    title="Get in touch"
    subtitle="Have a question or want to work together?"
    inputs={[
      { type: 'text', name: 'name', label: 'Name' },
      { type: 'email', name: 'email', label: 'Email' }
    ]}
    textarea={{ label: 'Message' }}
    description="I typically respond within 24 hours."
    button="Send Message"
  />

</Layout>
