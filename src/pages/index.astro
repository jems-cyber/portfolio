---
// 1. IMPORTS
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import Contact from '~/components/widgets/Contact.astro';

// We updated the metadata to reflect your brand.
const metadata = {
  title: 'Jeremy Ramesh — Cybersecurity & IOT',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>

  <!-- HERO WIDGET: Your main introduction -->
  <Hero
    actions={[
      // Primary button stands out more. Linking to projects section.
      { variant: 'primary', text: 'View My Work', href: '#projects', icon: 'tabler:briefcase' },
      // Secondary button links to your GitHub.
      { text: 'GitHub', href: 'https://github.com/jems-cyber', target: '_blank', icon: 'tabler:brand-github' },
    ]}
    // Make sure to put a cool photo of yourself or a logo here!
    image={{ src: '~/assets/images/hero-image.png', alt: 'Jeremy Ramesh' }}
  >
    <Fragment slot="title">
      Hi, I'm <span class="text-accent dark:text-white highlight">Jeremy Ramesh ;)</span>
    </Fragment>

    <Fragment slot="subtitle">
      <span class="font-semibold"> Cybersecurity & IOT student</span><br />
      Fluent in C, familiar with Docker, ZFS, Crowdsec and Caddy. Find here the tools I've developed as well as my ongoing and finished projects.
    </Fragment>
  </Hero>

  <!-- FEATURES WIDGET: Your Tech Stack -->
  <Features
    id="features"
    tagline="Skills"
    title="My Tech Stack"
    subtitle="The languages, tools, and environments I use."
    items={[
      { title: 'Debian/Mint', description: 'OS architecture, user and file rights, SFTP, Samba configurations.', icon: 'tabler:server' },
      { title: 'C & Python', description: 'Developed scripts for my OSINT tool.', icon: 'tabler:code' },
      { title: 'Cybersecurity Tools', description: 'Gobuster, Nmap, OSINT.', icon: 'tabler:shield-lock' },
      { title: 'Security Best Practices', description: 'Building with security and defense in mind.', icon: 'tabler:lock-check' },
    ]}
  />


  <!-- PROJECTS SECTION: Summary Cards -->
  <section id="projects" class="px-4 py-16 mx-auto max-w-7xl lg:py-20">
    <div class="flex flex-col mb-6 md:mb-12 text-center">
      <p class="text-base text-secondary dark:text-blue-200 font-bold tracking-wide uppercase">Portfolio</p>
      <h2 class="text-3xl md:text-4xl font-bold leading-tighter tracking-tighter mb-4 font-heading">Recent Projects</h2>
      <p class="max-w-3xl mx-auto sm:text-center text-xl text-muted dark:text-slate-400">A look into the tools and applications I've built and documented.</p>
    </div>
    
    <div class="grid gap-6 row-gap-5 md:grid-cols-2 lg:grid-cols-3">
      
      <!-- PROJECT CARD 1 -->
      <article class="mb-6 transition hover:shadow-lg rounded-2xl bg-white dark:bg-slate-900 shadow-md border border-gray-200 dark:border-gray-700">
        <a href="/project/osint-tool" class="block overflow-hidden rounded-t-2xl">
          <img src="https://images.unsplash.com/photo-1526374965328-7f61d4dc18c5?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" class="object-cover w-full h-48 transition hover:scale-105 duration-300" alt="OSINT Tool Project" />
        </a>
        <div class="p-6">
          <h3 class="mb-2 text-xl font-bold leading-tight sm:text-2xl font-heading">
            <a href="/project/osint-tool" class="hover:text-primary transition ease-in-duration-200">OSINT Reconnaissance Tool</a>
          </h3>
          <p class="text-muted dark:text-slate-400 text-base mb-4">A custom-built Python and C script for gathering open-source intelligence securely and efficiently.</p>
          
          <!-- Skill Tags -->
          <div class="flex flex-wrap gap-2 mb-4">
            <span class="bg-blue-100 text-blue-800 text-xs font-medium px-2.5 py-0.5 rounded dark:bg-blue-900 dark:text-blue-300">Python</span>
            <span class="bg-blue-100 text-blue-800 text-xs font-medium px-2.5 py-0.5 rounded dark:bg-blue-900 dark:text-blue-300">C</span>
            <span class="bg-blue-100 text-blue-800 text-xs font-medium px-2.5 py-0.5 rounded dark:bg-blue-900 dark:text-blue-300">Nmap</span>
          </div>
          
          <!-- Link to detailed tutorial page -->
          <a href="/project/osint-tool" class="inline-flex items-center font-medium text-primary hover:underline">
            More explanation
            <svg class="w-4 h-4 ml-1" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M12.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd"></path></svg>
          </a>
        </div>
      </article>

      <!-- You can copy/paste the <article> block above to add more projects! -->

    </div>
  </section>


  <!-- CONTACT SECTION -->
  <Contact
    id="contact"
    title="Get in touch"
    subtitle="Have a question or want to work together?"
    inputs={[
      { type: 'text', name: 'name', label: 'Name' },
      { type: 'email', name: 'email', label: 'Email' }
    ]}
    textarea={{ label: 'Message' }}
    description="I typically respond within 24 hours."
    button="Send Message"
  />

</Layout>
