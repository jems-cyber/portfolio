---
// 1. IMPORTS
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import Steps from '~/components/widgets/Steps.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

// We updated the metadata to reflect your brand, not AstroWind's.
const metadata = {
  title: 'Jeremy Ramesh — Web Developer & Node.js Expert',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  
  <!-- HERO WIDGET: Your main introduction -->
  <Hero
    actions={[
      // Primary button stands out more. Linking to a future projects section.
      { variant: 'primary', text: 'View My Work', href: '#projects', icon: 'tabler:briefcase' },
      // Secondary button links to your GitHub.
      { text: 'GitHub', href: 'https://github.com/jems-cyber', target: '_blank', icon: 'tabler:brand-github' },
    ]}
    // Make sure to put a cool photo of yourself or a logo here!
    image={{ src: '~/assets/images/hero-image.png', alt: 'Jeremy Ramesh' }}
  >
    <Fragment slot="title">
      Hi, I'm <span class="text-accent dark:text-white highlight">Jeremy Ramesh</span>
    </Fragment>

    <Fragment slot="subtitle">
      <span class="font-semibold">Web Developer & Node.js Enthusiast.</span>
      I specialize in building fast, secure, and scalable web applications using modern tools like Astro and Tailwind CSS.
    </Fragment>
  </Hero>


  <!-- FEATURES WIDGET: Repurposed to show your Tech Stack -->
  <Features
    id="features"
    tagline="Skills"
    title="My Tech Stack"
    subtitle="The languages and frameworks I use to bring ideas to life."
    items={[
      { title: 'Node.js', description: 'Backend development, REST APIs, and server-side logic.', icon: 'tabler:brand-nodejs' },
      { title: 'Astro', description: 'Island architecture for shipping zero-JS by default.', icon: 'tabler:rocket' },
      { title: 'Tailwind CSS', description: 'Rapid, responsive UI development.', icon: 'tabler:brand-tailwind' },
      { title: 'Cybersecurity', description: 'Building with security best practices in mind.', icon: 'tabler:shield-lock' },
    ]}
  />


  <!-- CONTENT WIDGET: Repurposed for an "About Me" section -->
  <!-- 'isReversed' puts the image on the left and text on the right -->
  <Content
    isReversed
    tagline="About Me"
    title="Bridging the gap between design and backend."
    items={[
      { title: 'Clean Code', description: 'Writing maintainable and readable code is my priority.' },
      { title: 'Performance First', description: 'I care about Lighthouse scores and fast load times.' },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1498050108023-c5249f4df085?ixlib=rb-4.0.3&auto=format&fit=crop&w=2072&q=80',
      alt: 'Coding workspace',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">My Philosophy</h3>
      I believe that great web experiences require a deep understanding of both the server and the browser.
    </Fragment>
  </Content>


  <!-- STEPS WIDGET: Repurposed to show your workflow or experience -->
  <Steps
    title="My Development Workflow"
    items={[
      { title: 'Step 1: <span class="font-medium">Architecture</span>', description: 'Planning the database structure, API endpoints, and choosing the right tech.', icon: 'tabler:schema' },
      { title: 'Step 2: <span class="font-medium">Development</span>', description: 'Writing clean, testable code and building responsive interfaces.', icon: 'tabler:code' },
      { title: 'Step 3: <span class="font-medium">Deployment</span>', description: 'Setting up CI/CD pipelines and hosting on platforms like Cloudflare.', icon: 'tabler:rocket' },
      { title: 'Ready to launch!', icon: 'tabler:check' },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1616198814651-e71f960c3180?ixlib=rb-4.0.3&auto=format&fit=crop&w=987&q=80',
      alt: 'Workflow image',
    }}
  />


  <!-- BLOG WIDGET: Keeps pulling your latest markdown files automatically -->
  <BlogLatestPosts
    title="Latest Writings"
    information={`I occasionally write about web development, Node.js tricks, and my journey in tech.`}
  />


  <!-- CALL TO ACTION: A simple contact prompt at the bottom -->
  <CallToAction
    actions={[
      { variant: 'primary', text: 'Email Me', href: 'mailto:your.email@example.com', icon: 'tabler:mail' },
    ]}
  >
    <Fragment slot="title">Let's build something great.</Fragment>
    <Fragment slot="subtitle">Currently open for new opportunities and collaborations.</Fragment>
  </CallToAction>

</Layout>
